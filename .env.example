# Optional, used to run the integration tests
INTEGRATION_RHINESTONE_API_KEY=
# Optional, required only for funded specs (non-sponsored cross-chain,
# spending-limit policies). The address derived from this key must hold testnet
# native + USDC on the integration chains.
INTEGRATION_FUNDER_PRIVATE_KEY=

# Required for the full integration suite (not EVM smoke): JSON array of 64
# integer bytes from a Solana keypair, funded with Devnet SOL and USDC.
INTEGRATION_SOLANA_FUNDER_PRIVATE_KEY=
# Shared EVM/Solana environment: production by default. Set the dev endpoint
# to use dev contracts. Endpoint and contract selection must agree for Solana.
INTEGRATION_ORCHESTRATOR_URL=
INTEGRATION_USE_DEV_CONTRACTS=
# Optional Devnet RPC override; genesis is checked before signing/funding.
INTEGRATION_SOLANA_RPC_URL=
# Optional Base Sepolia RPC override; chain ID must be 84532.
INTEGRATION_RPC_URL_84532=
